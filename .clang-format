---
BasedOnStyle: LLVM
---
Language: Cpp
DerivePointerAlignment: false
PointerAlignment: Left
AlignAfterOpenBracket: AlwaysBreak
BinPackArguments: false
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: "^<[^.]*>"
    Priority: 1
  - Regex: "^<.*>"
    Priority: 2
  - Regex: ".*"
    Priority: 3
